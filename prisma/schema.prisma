generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  username     String   @unique
  password     String
  role         String   @default("USER") // ADMIN, SELLER, or USER
  credits      Int      @default(0)
  checkerUsesToday Int      @default(0)
  checkerResetDate DateTime @default(now())
  ipAddress    String?  // IP at registration
  fingerprint  String?  // browser fingerprint
  region       String?  // ISO country code (e.g., PE, MX)
  sellerId     String?  // ID of the seller who created this user
  referralCode String?  @unique // e.g. HF-A3K9M
  referredBy      String?  // userId of the user who referred this user
  hasSeenOnboarding Boolean @default(false) // tutorial de bienvenida
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  transactions        Transaction[]
  createdKeys         GiftKey[]   @relation("CreatedKeys")
  redeemedKeys        GiftKey[]   @relation("RedeemedKeys")
  seller              User?       @relation("SellerUsers", fields: [sellerId], references: [id])
  managedUsers        User[]      @relation("SellerUsers")
  referredByUser      User?       @relation("ReferralRelation", fields: [referredBy], references: [id])
  referredUsers       User[]      @relation("ReferralRelation")
  createdNotifications Notification[] @relation("CreatedNotifications")

  @@index([role])
  @@index([sellerId])
  @@index([referredBy])
  @@index([ipAddress])
  @@index([fingerprint])
  @@index([region])
}

model Notification {
  id        String   @id @default(cuid())
  title     String
  message   String
  type      String   @default("info") // info, warning, success, welcome
  active    Boolean  @default(true)
  createdBy String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  creator   User     @relation("CreatedNotifications", fields: [createdBy], references: [id])

  @@index([active])
  @@index([createdAt])
}

model Cookie {
  id        String   @id @default(cuid())
  rawCookie String
  status    String   @default("ACTIVE") // ACTIVE, DEAD, or PENDING
  usedCount Int      @default(0)
  lastUsed  DateTime?
  lastError String?
  country   String?
  plan      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([country])
  @@index([status, country])
}

model Transaction {
  id          String   @id @default(cuid())
  userId      String
  type        String // GENERATE_TOKEN, COPY_COOKIE, ADMIN_GRANT, ADMIN_DEDUCT, SELLER_GRANT, SELLER_DEDUCT, REGISTER_BONUS
  credits     Int      // positive for grants, negative for usage
  description String?
  createdAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([type])
  @@index([createdAt])
}

model SiteConfig {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String
  updatedAt DateTime @updatedAt
}

model GiftKey {
  id          String    @id @default(cuid())
  code        String    @unique  // e.g. HJFLIX-A3K9M
  credits     Int
  createdBy   String    // admin userId
  redeemedBy  String?   // user userId who redeemed
  redeemedAt  DateTime?
  createdAt   DateTime  @default(now())

  creator     User      @relation("CreatedKeys", fields: [createdBy], references: [id])
  redeemer    User?     @relation("RedeemedKeys", fields: [redeemedBy], references: [id])

  @@index([redeemedBy])
  @@index([createdBy])
}

model CreditKey {
  id        String    @id @default(cuid())
  code      String    @unique  // e.g. CRED-HJ-A3K9M
  userId    String    // user who generated this key
  used      Boolean   @default(false)
  usedBy    String?   // user who redeemed (same as userId in normal flow)
  usedAt    DateTime?
  expiresAt DateTime  // 15 minutes from creation
  createdAt DateTime  @default(now())

  @@index([userId])
  @@index([code])
  @@index([used])
}
